{
  "name": "cherryland",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "studio": "sanity dev",
    "typegen": "sanity schema extract --enforce-required-fields --path sanity/extract.json && sanity typegen generate",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:dry": "tsx scripts/seed.ts --dry"
  },
  "dependencies": {
    "@portabletext/react": "^3.1.0",
    "@portabletext/types": "^2.0.13",
    "@sanity/client": "^6.22.0",
    "@sanity/webhook": "^4.0.4",
    "groq": "^6.20.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/styled-components": "^5.1.36",
    "sanity": "^3.62.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
